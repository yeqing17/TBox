<Application
    x:Class="TBox.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TBox">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PanelBg" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="PanelTint" Color="#EB1E1E1E" />
                    <SolidColorBrush x:Key="PanelStroke" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="PanelFg" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PanelFgSecondary" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="PanelFgTertiary" Color="#73FFFFFF" />
                    <SolidColorBrush x:Key="CardHover" Color="#14FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelBg" Color="#FFF4F4F4" />
                    <SolidColorBrush x:Key="PanelTint" Color="#F0F7F7F7" />
                    <SolidColorBrush x:Key="PanelStroke" Color="#18000000" />
                    <SolidColorBrush x:Key="PanelFg" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="PanelFgSecondary" Color="#99000000" />
                    <SolidColorBrush x:Key="PanelFgTertiary" Color="#59000000" />
                    <SolidColorBrush x:Key="CardHover" Color="#0D000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />


            <Style x:Key="PanelIconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PanelFgSecondary}" />
            </Style>

            <Style x:Key="PanelTabItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>

            <Style x:Key="PanelCardItem" TargetType="GridViewItem">
                <Setter Property="Margin" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
