<Window
    x:Class="TBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TBox.Models"
    Title="TBox">

    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Border x:Name="CollapsedBar" Visibility="Collapsed" Width="16"
                HorizontalAlignment="Left" CornerRadius="4"
                Background="{ThemeResource PanelBg}"
                PointerPressed="OnCollapsedBarPressed">
            <Border Width="3" Height="90" CornerRadius="1.5" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Opacity="0.55"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
        </Border>

        <Border x:Name="Panel" CornerRadius="14" BorderThickness="0"
                Background="{ThemeResource PanelTint}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Padding="14,0,8,0"
                      Background="Transparent"
                      PointerPressed="OnHeaderPointerPressed"
                      PointerMoved="OnHeaderPointerMoved"
                      PointerReleased="OnHeaderPointerReleased"
                      PointerCanceled="OnHeaderPointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE7B8;" FontSize="11" Foreground="White" />
                        </Border>
                        <TextBlock Text="TBox" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Column="1" MinWidth="120" MaxWidth="300" Margin="18,0,12,0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Height="32" Padding="10,8,10,3" FontSize="12.5"
                                 VerticalContentAlignment="Top" HorizontalAlignment="Stretch"
                                 Visibility="Collapsed"
                                 ToolTipService.ToolTip="按名称、描述、关键字搜索"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索…"
                                   FontSize="12.5" Margin="11,0,0,7" VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource PanelFgTertiary}" IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="SearchToggle" Style="{StaticResource PanelIconButton}" Click="OnSearchToggleClick"
                                ToolTipService.ToolTip="搜索（Ctrl+F）">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                        <Button x:Name="AddButton" Style="{StaticResource AccentButtonStyle}"
                                Width="32" Height="32" Padding="0" Click="OnAddClick"
                                ToolTipService.ToolTip="添加工具">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource PanelIconButton}" Click="OnRaiseClick"
                                ToolTipService.ToolTip="弹出面板 / 放回桌面">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource PanelIconButton}" Click="OnSettingsClick"
                                ToolTipService.ToolTip="设置">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource PanelIconButton}" Click="OnHideClick"
                                ToolTipService.ToolTip="收起（托盘 Ctrl+Alt+T 唤回）">
                            <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Group tabs ===== -->
                <Grid Grid.Row="1" Padding="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView x:Name="Tabs" Grid.Column="0" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource PanelTabItem}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              VerticalAlignment="Center"
                              SelectionChanged="OnTabChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ItemGroup">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11" Opacity="0.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Column="1" Style="{StaticResource PanelIconButton}" Click="OnNewGroupClick"
                            ToolTipService.ToolTip="新建分组">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- ===== Items ===== -->
                <Grid Grid.Row="2">
                    <GridView x:Name="ItemsView"
                              SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="OnItemClick" RightTapped="OnRightTapped"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              DragItemsCompleted="OnItemsReordered"
                              Drop="OnFileDrop" DragOver="OnFileDragOver"
                              Padding="10,2,6,8"
                              ItemContainerStyle="{StaticResource PanelCardItem}"
                              Background="Transparent" BorderThickness="0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppItem">
                                <Grid Width="88" Height="88" ToolTipService.ToolTip="{x:Bind DisplayTarget}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="44" Height="44"
                                                   Stretch="Uniform" />
                                            <Border Width="11" Height="11" CornerRadius="6"
                                                    Background="#E81123" BorderBrush="White" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-2,-2,0"
                                                    Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                                            <Border x:Name="Ph" CornerRadius="9" Background="#1FFFFFFF"
                                                    Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="18" Opacity="0.5" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                   Margin="2,6,2,0" Opacity="0.78" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7B8;" FontSize="34" Opacity="0.35" />
                        <TextBlock Text="盒子还是空的" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="把桌面上的快捷方式拖进来，或者从桌面一键导入" FontSize="12"
                                   Opacity="0.6" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="添加工具" Style="{StaticResource AccentButtonStyle}" Click="OnAddClick" />
                            <Button Content="从桌面导入" Click="OnImportClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Status ===== -->
                <Grid Grid.Row="3" Padding="16,0">
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.45" VerticalAlignment="Center" />

                </Grid>
                <Border x:Name="DockHint" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                        Grid.Row="0" Grid.RowSpan="4" Canvas.ZIndex="9" IsHitTestVisible="False"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- ===== Resize grip ===== -->
                <Border Grid.Row="0" Grid.RowSpan="4"
                        Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,3,3" Background="Transparent" Canvas.ZIndex="10"
                        PointerPressed="OnGripPointerPressed"
                        PointerMoved="OnGripPointerMoved"
                        PointerReleased="OnGripPointerReleased">
                    <FontIcon Glyph="&#xE744;" FontSize="10" Opacity="0.35"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
